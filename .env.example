# --- BigCommerce credentials (required) ---

# Store hash from your store's API path: /stores/{store_hash}/v3/
BIGCOMMERCE_STORE_HASH=your_store_hash_here

# API account access token with the scopes you need.
# Read-only usage needs: Products (read), Orders (read), Customers (read).
BIGCOMMERCE_API_KEY=your_api_key_here


# --- Write access (optional, off by default) ---

# Write tools (create_product, update_product, create_customer,
# update_customer, update_order) are not registered unless this is true.
# Enabling it means anyone who can call this server can change your store,
# and your API account needs modify scopes.
# BIGCOMMERCE_ENABLE_WRITES=true


# --- Server auth and binding (streamable-http transport only) ---

# If set, clients must send "Authorization: Bearer <token>".
# Strongly recommended whenever the server is reachable off-localhost.
MCP_AUTH_TOKEN=your_secure_token_here

# Bind address. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 to expose the server on all interfaces.
# HOST=0.0.0.0

# Port for the HTTP transport. Defaults to 3000.
# PORT=3000

# Browser origins allowed to call the server, comma-separated. Empty means no
# browser origin is accepted; requests without an Origin header (Claude
# Desktop, curl, agent runtimes) are unaffected.
# ALLOWED_ORIGINS=https://your-app.example
